# Supabase Credentials
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Cross-device sync (table app_records, see supabase/migrations/20261028_app_records_sync.sql)
# All devices of one facility must use the same VITE_ORG_ID.
VITE_ORG_ID="default"
# Set to "false" to keep data only on this device
VITE_CLOUD_SYNC="true"
# Use the server-side record_attendance_scan() RPC instead of the in-app scan rules
VITE_USE_SCAN_RPC="false"

# Application Settings
VITE_APP_NAME="Absence"
VITE_APP_ORG_NAME="ABC Care - Shimada"
VITE_SCANNER_CAMERA_FACING="user"
VITE_FEEDBACK_AUTO_RESET_MS="3000"
